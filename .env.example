# Database Configuration
# SQLite for quick local setup, or postgresql://user:password@localhost:5432/brahmalingeshwara_cup
DATABASE_URL="file:./dev.db"

# Server Secrets
JWT_SECRET="replace-with-a-very-strong-secret-key-min-32-chars"
SESSION_SECRET="replace-with-another-strong-secret-key"

# Admin Credentials Output Location
ADMIN_CREDENTIALS_FILE="admin_credentials.txt"

# Razorpay Payment Gateway Credentials
# Obtain these from your Razorpay Dashboard (https://dashboard.razorpay.com) -> Settings -> API Keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Public Razorpay Key for Checkout JS (matches RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upload Storage Directory
UPLOAD_DIR="./uploads"

# Security Configuration
MAX_UPLOAD_SIZE_MB=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
